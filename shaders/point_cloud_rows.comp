#version 450
// NxStereo.Depth.point_cloud/5 for one row of the grid: the x, y, z point
// of every DECIMATION-th depth pixel, NaN where the depth is not strictly
// between the minimum and maximum, and the number of points kept;
// column_sums.comp adds the rows' counts.
#define GROUP 64
layout(local_size_x = GROUP) in;

layout(constant_id = 0) const int WIDTH = 364;
layout(constant_id = 1) const int GRID_WIDTH = 91;
layout(constant_id = 2) const int DECIMATION = 4;

layout(set = 0, binding = 0) readonly buffer DepthM { float depth_m[]; };
// focal_length_px, cx, cy, min_depth_m, max_depth_m
layout(set = 0, binding = 1) readonly buffer Params { float params[]; };
layout(set = 0, binding = 2) writeonly buffer Grid { float grid[]; };
layout(set = 0, binding = 3) writeonly buffer Kept { float kept[]; };

shared uint counts[GROUP];

void main() {
  int row = int(gl_WorkGroupID.x);
  uint t = gl_LocalInvocationID.x;
  float nan = uintBitsToFloat(0x7fc00000u);
  uint count = 0u;

  for (int column = int(t); column < GRID_WIDTH; column += GROUP) {
    float z = depth_m[row * DECIMATION * WIDTH + column * DECIMATION];
    int point = (row * GRID_WIDTH + column) * 3;
    if (z > params[3] && z < params[4]) {
      precise float z_over_f = z / params[0];
      precise float x = (float(column * DECIMATION) - params[1]) * z_over_f;
      precise float y = (float(row * DECIMATION) - params[2]) * z_over_f;
      grid[point] = x;
      grid[point + 1] = y;
      grid[point + 2] = z;
      count += 1u;
    } else {
      grid[point] = nan;
      grid[point + 1] = nan;
      grid[point + 2] = nan;
    }
  }

  counts[t] = count;
  barrier();
  for (uint stride = GROUP / 2; stride > 0u; stride >>= 1) {
    if (t < stride) counts[t] += counts[t + stride];
    barrier();
  }
  if (t == 0u) kept[row] = float(counts[0]);
}
