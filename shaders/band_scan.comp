#version 450
#extension GL_GOOGLE_include_directive : require
// Copyright 2016 Fixstars Corporation
// SPDX-License-Identifier: Apache-2.0
// NxStereo.sgm_band/4's path recurrence along one direction, a thread per
// line holding the line's whole band in registers. The direction moves DX
// columns and DY rows a step: DY = 0 is a horizontal scan of a row, otherwise
// a vertical (DX = 0) or diagonal scan visiting rows downwards (DY = 1) or
// upwards. Matching costs come from band_cost.comp. The previous pixel's
// normalized costs move to this pixel's band by disparity through a barrel
// shifter, so every array index is a constant, P2 standing for a candidate its
// band lacks. A step's loads are issued one step ahead. A horizontal scan
// reads band_transpose.comp's column-major costs, each pixel's base as its
// last word, and writes its paths column-major, so a wave's lines are
// consecutive in memory as a vertical scan's are; with PAIRED it adds the
// opposite scan's path bytes to its own.
layout(local_size_x = 64) in;
layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int HEIGHT = 480;
#include "params.glsl"
#include "band_common.glsl"
#define SPAN (BAND + 2)
#ifndef PAIRED
#define PAIRED 0
#endif
layout(set = 0, binding = 1) readonly buffer Costs { uint costs[]; };
#if DY == 0
#define PIXEL_WORDS (WORDS + 1)
#if PAIRED
layout(set = 0, binding = 2) readonly buffer Partner { uint partner[]; };
layout(set = 0, binding = 3) writeonly buffer Paths { uint paths[]; };
#else
layout(set = 0, binding = 2) writeonly buffer Paths { uint paths[]; };
#endif
int base_of(int pixel) { return int(costs[pixel * PIXEL_WORDS + WORDS]); }
#else
#define PIXEL_WORDS WORDS
layout(set = 0, binding = 2) readonly buffer Base { int base[]; };
layout(set = 0, binding = 3) writeonly buffer Paths { uint paths[]; };
int base_of(int pixel) { return base[pixel]; }
#endif

int lines() { return DY == 0 ? HEIGHT : (DX == 0 ? WIDTH : WIDTH + HEIGHT - 1); }

// The pixel of `line` at step `i`, or -1 outside the image; column-major in a
// horizontal scan.
int pixel_at(int line, int i) {
  int x, y;
  if (DY == 0) {
    y = line;
    x = DX > 0 ? i : WIDTH - 1 - i;
  } else {
    y = DY > 0 ? i : HEIGHT - 1 - i;
    x = DX > 0 ? line - (HEIGHT - 1) + i : (DX < 0 ? line - i : line);
  }
  if (x < 0 || x >= WIDTH) return -1;
  return DY == 0 ? x * HEIGHT + y : y * WIDTH + x;
}

// One step of the recurrence: previous becomes this pixel's path costs.
void advance(inout uint previous[BAND], inout int previous_base, int b, uint words[WORDS]) {
  // A path entering the image starts from zero, in its own band.
  int delta = previous_base >= 0 ? b - previous_base : 0;
  uint minimum = previous[0];
  for (int k = 1; k < BAND; ++k) minimum = min(minimum, previous[k]);

  // window[j] is the previous candidate j - 1 + delta, normalized.
  uint window[SPAN];
  window[0] = uint(P2);
  for (int k = 0; k < BAND; ++k) window[k + 1] = previous[k] - minimum;
  window[SPAN - 1] = uint(P2);
  int shift = clamp(delta, -SPAN, SPAN);
  int amount = abs(shift);
  for (int s = 1; s <= SPAN; s *= 2) {
    if ((amount & s) == 0) continue;
    uint moved[SPAN];
    for (int j = 0; j < SPAN; ++j) {
      // The ends hold P2 outside the band; candidates past them too.
      uint up = j + s < SPAN ? window[j + s] : uint(P2);
      uint down = j - s >= 0 ? window[j - s] : uint(P2);
      moved[j] = shift > 0 ? up : down;
    }
    for (int j = 0; j < SPAN; ++j) window[j] = moved[j];
  }

  for (int k = 0; k < BAND; ++k) {
    uint cost = (words[k / 4] >> (8 * (k % 4))) & 255u;
    uint own = min(window[k + 1], uint(P2));
    uint neighbour = min(window[k], window[k + 2]) + uint(P1);
    previous[k] = min(own, neighbour) + cost;
  }
  previous_base = b;
}

uint packed(uint previous[BAND], int w) {
  return previous[4 * w] | (previous[4 * w + 1] << 8) | (previous[4 * w + 2] << 16) |
         (previous[4 * w + 3] << 24);
}

void main() {
  load_params();
  int line = int(gl_GlobalInvocationID.x);
  if (line >= lines()) return;

  uint previous[BAND];
  for (int k = 0; k < BAND; ++k) previous[k] = 0u;
  int previous_base = -1;

  int pixel = pixel_at(line, 0);
  int b = pixel >= 0 ? max(base_of(pixel), 0) : 0;
  uint words[WORDS];
  for (int w = 0; w < WORDS; ++w) words[w] = pixel >= 0 ? costs[pixel * PIXEL_WORDS + w] : 0u;

  int steps = DY == 0 ? WIDTH : HEIGHT;
  for (int i = 0; i < steps; ++i) {
    int next_pixel = i + 1 < steps ? pixel_at(line, i + 1) : -1;
    int next_b = next_pixel >= 0 ? max(base_of(next_pixel), 0) : 0;
    uint next_words[WORDS];
    for (int w = 0; w < WORDS; ++w) next_words[w] = next_pixel >= 0 ? costs[next_pixel * PIXEL_WORDS + w] : 0u;

    if (pixel >= 0) {
      advance(previous, previous_base, b, words);
#if PAIRED
      for (int w = 0; w < WORDS; ++w) paths[pixel * WORDS + w] = packed(previous, w) + partner[pixel * WORDS + w];
#else
      for (int w = 0; w < WORDS; ++w) paths[pixel * WORDS + w] = packed(previous, w);
#endif
    }

    pixel = next_pixel;
    b = next_b;
    for (int w = 0; w < WORDS; ++w) words[w] = next_words[w];
  }
}
