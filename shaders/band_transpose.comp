#version 450
#extension GL_GOOGLE_include_directive : require
// The band's costs in the column-major order (x * HEIGHT + y) the horizontal
// scans read, each pixel's base appended as a last word. A workgroup moves a
// TILE x TILE tile, a thread a pixel, its consecutive threads down a column:
// the writes are contiguous runs, the reads runs of TILE pixels. Staging the
// tile through shared memory is slower on Adreno GPUs.
layout(local_size_x = 64) in;
layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int HEIGHT = 480;
#include "band_common.glsl"
#define TILE 8
#define PIXEL_WORDS (COST_WORDS + 1)
layout(set = 0, binding = 0) readonly buffer Source { uint source[]; };
layout(set = 0, binding = 1) readonly buffer Base { int base[]; };
layout(set = 0, binding = 2) writeonly buffer Target { uint target[]; };

void main() {
  int t = int(gl_LocalInvocationID.x);
  int x = int(gl_WorkGroupID.x) * TILE + t / TILE;
  int y = int(gl_WorkGroupID.y) * TILE + t % TILE;
  if (x >= WIDTH || y >= HEIGHT) return;
  int from = (y * WIDTH + x) * COST_WORDS, to = (x * HEIGHT + y) * PIXEL_WORDS;
  for (int w = 0; w < COST_WORDS; ++w) target[to + w] = source[from + w];
  target[to + COST_WORDS] = uint(base[y * WIDTH + x]);
}
