#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_GOOGLE_include_directive : require
// Copyright 2016 Fixstars Corporation
// SPDX-License-Identifier: Apache-2.0
// A scan's band is split across WORDS subgroup lanes, four candidates each.
// Shuffles align the previous costs by disparity without a per-thread band
// array. Lane groups are WORDS-aligned; each writes one packed path word.
layout(local_size_x = 64) in;
layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int HEIGHT = 480;
#include "params.glsl"
#include "band_common.glsl"
layout(set = 0, binding = 1) readonly buffer Costs { uint costs[]; };
#if DY == 0
#define PIXEL_WORDS (COST_WORDS + 1)
layout(set = 0, binding = 2) buffer Paths { uint paths[]; };
int base_of(int pixel) { return int(costs[pixel * PIXEL_WORDS + COST_WORDS]); }
#else
#define PIXEL_WORDS COST_WORDS
layout(set = 0, binding = 2) readonly buffer Base { int base[]; };
layout(set = 0, binding = 3) writeonly buffer Paths { uint paths[]; };
int base_of(int pixel) { return base[pixel]; }
#endif

#include "band_scan_geometry.glsl"

void store_path(int pixel, int lane, uint value, bool add) {
#if DY == 0
  if (add) value += paths[pixel * WORDS + lane];
#endif
  paths[pixel * WORDS + lane] = value;
}

#include "band_scan_lanes.glsl"

void main() {
  load_params();
  int lane = int(gl_LocalInvocationID.x) % WORDS;
  int line = int(gl_GlobalInvocationID.x) / WORDS;
  if (line < lines_of(DX, DY)) {
#if DY == 0
    scan(1, 0, line, lane, false);
    memoryBarrierBuffer();
    scan(-1, 0, line, lane, true);
#else
    scan(DX, DY, line, lane, false);
#endif
  }
}
