#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_GOOGLE_include_directive : require
// Copyright 2016 Fixstars Corporation
// SPDX-License-Identifier: Apache-2.0
// Selection over the stored paths, every pixel in parallel: a workgroup takes
// the LINES pixels of one tile column, so its loads are contiguous, and each
// lane group sums the 3 or 8 (PATHS) paths and selects as cost_select.glsl.
// The paths come summed in pairs: Adreno GPUs slow down sharply when a kernel
// reads more than a few volumes at once.
layout(local_size_x = 128) in;
// Image size is a specialization constant; the disparity
// range and lane layout stay compile-time macros.
layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int HEIGHT = 480;
#include "params.glsl"
#include "cost_dp.glsl"
#ifndef PATHS
#define PATHS 3
#endif
// The paths summed in pairs by the paired scans, read as 32-bit words.
#if PATHS == 8
#define VOLUMES 4
#define OUTPUT_BINDING 5
#else
#define VOLUMES 2
#define OUTPUT_BINDING 3
#endif
layout(set = 0, binding = 1) readonly buffer ForwardReverse { uint forward_reverse[]; };
#if PATHS == 8
layout(set = 0, binding = 2) readonly buffer UpDownRight { uint up_down_right[]; };
layout(set = 0, binding = 3) readonly buffer DownLeftUpRight { uint down_left_up_right[]; };
layout(set = 0, binding = 4) readonly buffer DownUpLeft { uint down_up_left[]; };
#else
layout(set = 0, binding = 2) readonly buffer Down { uint down[]; };
#endif
layout(set = 0, binding = OUTPUT_BINDING) writeonly buffer LeftDisparity { float left_disparity[]; };
layout(set = 0, binding = OUTPUT_BINDING + 1) writeonly buffer Winners { uint winners[]; };
#include "cost_select.glsl"
// A workgroup's pixels are one tile of each volume. Its threads load the
// tiles into shared memory as consecutive 32-bit words, the access Adreno
// GPUs read at full bandwidth, and each lane then takes its own word.
#define UINTS_PER_WORD (PATH_PACK / 4)
#define TILE_UINTS (TILE_WORDS * UINTS_PER_WORD)
shared uint tiles[VOLUMES][TILE_UINTS];
PATH_WORD_TYPE tile_word(int volume, int index) {
#if PATH_PACK == 8
  return uvec2(tiles[volume][2 * index], tiles[volume][2 * index + 1]);
#else
  return tiles[volume][index];
#endif
}
void main() {
  load_params();
  uint lane = gl_SubgroupInvocationID % LANES;
  uint base = gl_SubgroupInvocationID - lane;
  int x = int(gl_WorkGroupID.x);
  int row = int(gl_LocalInvocationID.x) / LANES;
  int y = int(gl_WorkGroupID.y) * LINES + row;
  int first = volume_word(x, int(gl_WorkGroupID.y) * LINES, 0) * UINTS_PER_WORD;
  for (int i = int(gl_LocalInvocationID.x); i < TILE_UINTS; i += 128) {
    tiles[0][i] = forward_reverse[first + i];
#if PATHS == 8
    tiles[1][i] = up_down_right[first + i];
    tiles[2][i] = down_left_up_right[first + i];
    tiles[3][i] = down_up_left[first + i];
#else
    tiles[1][i] = down[first + i];
#endif
  }
  barrier();
  // Whole lane groups share a pixel, so the selection's shuffles read active lanes.
  if (y >= HEIGHT) return;
  int index = row * WORDS_PER_PIXEL + int(lane) * WORDS_PER_LANE;
  uint stored[BLOCK], pair[BLOCK], none[BLOCK];
  for (int k = 0; k < BLOCK; ++k) {
    stored[k] = 0u;
    none[k] = 0u;
  }
  for (int v = 0; v < VOLUMES; ++v) {
    for (int k = 0; k < BLOCK; k += PATH_PACK) {
      unpack_lane(tile_word(v, index + k / PATH_PACK), pair, k);
      for (int i = k; i < k + PATH_PACK; ++i) stored[i] += pair[i];
    }
  }
  select_sum(none, y * WIDTH + x, stored, select_geometry(x, lane, base));
}
