#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_GOOGLE_include_directive : require
// Copyright 2016 Fixstars Corporation
// SPDX-License-Identifier: Apache-2.0
// A bottom-to-top or diagonal scan over the stored matching costs. Rows are
// visited downwards (STEP_Y = 1) or upwards (STEP_Y = -1) and the path moves
// STEP_X columns per row, so line l covers column l (STEP_X = 0),
// l - (HEIGHT - 1) + i (STEP_X = 1) or l - i (STEP_X = -1) at step i. A
// diagonal line keeps a zero path until it enters the image. With SELECT, the
// three-path selection runs in the scan: each pixel's path is added to the
// forward and reverse sum and selected as cost_select.glsl, and no path is
// stored.
layout(local_size_x = 128) in;
// Image size is a specialization constant; the disparity
// range and lane layout stay compile-time macros.
layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int HEIGHT = 480;
#include "params.glsl"
#include "cost_dp.glsl"
layout(set = 0, binding = 1) readonly buffer Costs { PATH_WORD_TYPE cost_words[]; };
#if SELECT
layout(set = 0, binding = 2) readonly buffer ForwardReverse { PATH_WORD_TYPE forward_reverse[]; };
layout(set = 0, binding = 3) writeonly buffer LeftDisparity { float left_disparity[]; };
layout(set = 0, binding = 4) writeonly buffer Winners { uint winners[]; };
#include "cost_select.glsl"
#else
#if PAIRED
// The partner path's volume: the scan writes the sum of both, each byte below
// 128, so the selection reads half as many volumes.
layout(set = 0, binding = 2) readonly buffer Partner { PATH_WORD_TYPE partner[]; };
layout(set = 0, binding = 3) writeonly buffer Paths { PATH_WORD_TYPE paths[]; };
#else
layout(set = 0, binding = 2) writeonly buffer Paths { PATH_WORD_TYPE paths[]; };
#endif
#endif
PATH_WORD_TYPE stored_path(uint previous[BLOCK], int word, int first) {
#if PAIRED
  return pack_lane(previous, first) + partner[word];
#else
  return pack_lane(previous, first);
#endif
}
void main() {
  load_params();
  uint lane = gl_SubgroupInvocationID % LANES;
  LaneGeometry g = lane_geometry(lane);
  int line = int(gl_WorkGroupID.x) * LINES + int(gl_LocalInvocationID.x) / LANES;
  if (line >= (STEP_X == 0 ? WIDTH : WIDTH + HEIGHT - 1)) return;
  uint previous[BLOCK];
  for (int k = 0; k < BLOCK; ++k) previous[k] = 0;
  uint last_min = 0;
  for (int i = 0; i < HEIGHT; ++i) {
    int y = STEP_Y > 0 ? i : HEIGHT - 1 - i;
    int x = STEP_X > 0 ? line - (HEIGHT - 1) + i : (STEP_X < 0 ? line - i : line);
    // Whole lane groups share a line, so shuffles only read active lanes.
    if (x < 0 || x >= WIDTH) continue;
    int word = volume_word(x, y, lane);
    uint costs[BLOCK];
    for (int k = 0; k < BLOCK; k += PATH_PACK) unpack_lane(cost_words[word + k / PATH_PACK], costs, k);
    update_path(costs, previous, last_min, g);
#if SELECT
    uint stored[BLOCK];
    for (int k = 0; k < BLOCK; k += PATH_PACK) unpack_lane(forward_reverse[word + k / PATH_PACK], stored, k);
    select_sum(previous, y * WIDTH + x, stored, select_geometry(x, lane, gl_SubgroupInvocationID - lane));
#else
    for (int k = 0; k < BLOCK; k += PATH_PACK) paths[word + k / PATH_PACK] = stored_path(previous, word + k / PATH_PACK, k);
#endif
  }
}
