#version 450
#extension GL_GOOGLE_include_directive : require
// Copyright 2016 Fixstars Corporation
// SPDX-License-Identifier: Apache-2.0
// NxStereo.sgm_band/4's matching costs, computed once for every path: the
// Hamming distance between a pixel's left census and the right census of each
// candidate in its band, packed 6 bits a candidate as band_common.glsl reads
// them. A workgroup covers ROWS rows of 64 pixels: it loads the right census
// of every column they can reach once, into shared memory, reading whole runs
// of the feature tiles, and each thread writes its pixels' costs.
layout(local_size_x = 64) in;
layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int HEIGHT = 480;
layout(constant_id = 2) const int DISPARITIES = 128;
#include "band_common.glsl"
// census_pair.comp's features as halves: a pixel's left census, then its right.
layout(set = 0, binding = 0) readonly buffer Features { uvec2 features[]; };
layout(set = 0, binding = 1) readonly buffer Base { int base[]; };
layout(set = 0, binding = 2) writeonly buffer Costs { uint costs[]; };
#define ROWS 4
#define REACH (64 + DISPARITIES - 1)
// Per row, columns first .. first + REACH - 1, first = the workgroup's - (DISPARITIES - 1).
shared uvec2 right_census[ROWS * REACH];

void main() {
  int t = int(gl_LocalInvocationID.x);
  int top = int(gl_WorkGroupID.y) * ROWS;
  int start = int(gl_WorkGroupID.x) * 64;
  int x = start + t;
  int first = start - (DISPARITIES - 1);

  // Consecutive threads read a column's consecutive rows, adjacent in the feature tiles.
  for (int m = t; m < ROWS * REACH; m += 64) {
    int r = m % ROWS, column = first + m / ROWS, y = top + r;
    // Right features left of the image are zero, as libSGM pads them.
    right_census[r * REACH + m / ROWS] =
        column >= 0 && column < WIDTH && y < HEIGHT ? features[2 * feature_index(column, y) + 1] : uvec2(0u);
  }
  barrier();

  if (x >= WIDTH) return;
  for (int r = 0; r < ROWS; ++r) {
    int y = top + r;
    if (y >= HEIGHT) break;
    int b = max(base[y * WIDTH + x], 0);
    uvec2 centre = features[2 * feature_index(x, y)];
    // The band's right census, lowest column first: candidate k is BAND - 1 - k.
#if BAND == 64
    // Bound the live census signatures while retaining consecutive shared loads.
    int lowest = r * REACH + x - b - (BAND - 1) - first;
    uint words[COST_WORDS];
    for (int w = 0; w < COST_WORDS; ++w) words[w] = 0u;
    for (int chunk_start = 0; chunk_start < BAND; chunk_start += 4) {
      uvec2 band_census[4];
      for (int j = 0; j < 4; ++j) band_census[j] = right_census[lowest + chunk_start + j];
      for (int j = 0; j < 4; ++j) {
        int k = BAND - 1 - chunk_start - j;
        uvec2 right = band_census[j];
        uint cost = bitCount(centre.x ^ right.x) + bitCount(centre.y ^ right.y);
        int bit = 6 * k, w = bit / 32, shift = bit % 32;
        words[w] |= cost << shift;
        if (shift > 26) words[w + 1] |= cost >> (32 - shift);
      }
    }
#else
    uvec2 band_census[BAND];
    int lowest = r * REACH + x - b - (BAND - 1) - first;
    for (int j = 0; j < BAND; ++j) band_census[j] = right_census[lowest + j];
    uint words[COST_WORDS];
    for (int w = 0; w < COST_WORDS; ++w) words[w] = 0u;
    for (int k = 0; k < BAND; ++k) {
      uvec2 right = band_census[BAND - 1 - k];
      uint cost = bitCount(centre.x ^ right.x) + bitCount(centre.y ^ right.y);
      int bit = 6 * k, w = bit / 32, shift = bit % 32;
      words[w] |= cost << shift;
      if (shift > 26) words[w + 1] |= cost >> (32 - shift);
    }
#endif
    for (int w = 0; w < COST_WORDS; ++w) costs[(y * WIDTH + x) * COST_WORDS + w] = words[w];
  }
}
