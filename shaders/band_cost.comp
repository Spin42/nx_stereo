#version 450
#extension GL_GOOGLE_include_directive : require
// Copyright 2016 Fixstars Corporation
// SPDX-License-Identifier: Apache-2.0
// NxStereo.sgm_band/4's matching costs, computed once for every path: the
// Hamming distance between a pixel's left census and the right census of each
// candidate in its band, a byte per candidate, packed as the paths are. A
// workgroup covers FEATURE_TILE rows of 64 / FEATURE_TILE columns, so its
// census loads are contiguous.
layout(local_size_x = 64) in;
layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int HEIGHT = 480;
#include "band_common.glsl"
#define COLUMNS (64 / FEATURE_TILE)
// census_pair.comp's features as halves: a pixel's left census, then its right.
layout(set = 0, binding = 0) readonly buffer Features { uvec2 features[]; };
layout(set = 0, binding = 1) readonly buffer Base { int base[]; };
layout(set = 0, binding = 2) writeonly buffer Costs { uint costs[]; };

void main() {
  int local = int(gl_LocalInvocationID.x);
  int x = int(gl_WorkGroupID.x) * COLUMNS + local / FEATURE_TILE;
  int y = int(gl_WorkGroupID.y) * FEATURE_TILE + local % FEATURE_TILE;
  if (x >= WIDTH || y >= HEIGHT) return;
  int pixel = y * WIDTH + x;
  int b = max(base[pixel], 0);
  uvec2 centre = features[2 * feature_index(x, y)];

  for (int w = 0; w < WORDS; ++w) {
    uint word = 0u;
    for (int c = 0; c < 4; ++c) {
      int source = x - (b + 4 * w + c);
      // Right features left of the image are zero, as libSGM pads them.
      uvec2 right = source >= 0 ? features[2 * feature_index(source, y) + 1] : uvec2(0u);
      word |= (bitCount(centre.x ^ right.x) + bitCount(centre.y ^ right.y)) << (8 * c);
    }
    costs[pixel * WORDS + w] = word;
  }
}
