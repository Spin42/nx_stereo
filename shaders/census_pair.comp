// Vulkan adaptation of libSGM's census transform (9x7 window).
layout(local_size_x = 128) in;
// Image size is a specialization constant; the disparity
// range and lane layout stay compile-time macros.
layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int HEIGHT = 480;
layout(set = 0, binding = 0) readonly buffer Left { int left_image[]; };
layout(set = 0, binding = 1) readonly buffer Right { int right_image[]; };
#define FEATURE_PAIR uvec4
// Left and right features of a pixel share one element, stored in tiles of
// FEATURE_TILE consecutive rows per column, matching the byte volumes.
layout(set = 0, binding = 2) writeonly buffer Features { FEATURE_PAIR features[]; };
// A workgroup covers COLUMNS columns of GROUP_ROWS rows; a thread computes
// QUAD consecutive pixels of a row, so each row of their shared window is
// read once, as consecutive words, for all of them.
#define QUAD 4
#define COLUMNS (128 / FEATURE_TILE)
#define GROUP_ROWS (128 * QUAD / COLUMNS)
#define WINDOW_COLUMNS (COLUMNS + 8)
#define WINDOW_ROWS (GROUP_ROWS + 6)
#define STRIDE WINDOW_COLUMNS
// One shared word holds both images of a pixel in 16-bit lanes, each offset by
// 0x100. Subtracting the unoffset centre word, lowered by one level and
// clamped at zero in each lane, then yields, without borrows between lanes,
// bit 8 (left) and bit 24 (right) set exactly when the neighbour is not more
// than one level below the centre. Chunks accumulate those complemented
// Census bits and are inverted once at the end.
#define LANE_OFFSET 0x01000100u
#define COMPARE_MASK 0x01000100u
shared uint rows[WINDOW_ROWS * STRIDE];
uint load_pair(int x, int y) {
  int pixel = clamp(y, 0, HEIGHT - 1) * WIDTH + clamp(x, 0, WIDTH - 1);
  return (uint(left_image[pixel]) | (uint(right_image[pixel]) << 16)) + LANE_OFFSET;
}
// The census bits of window row `dy` for pixel `p` of the quad, from the 12
// words the quad's window row holds: neighbour n of 8 lands at bit 7 - n.
uint row_bits(uint words[QUAD + 8], int p, uint a) {
  uint bits = 0u;
  for (int n = 0; n < 8; ++n) {
    int dx = n < 4 ? n - 4 : n - 3;
    bits |= ((words[p + 4 + dx] - a) & COMPARE_MASK) << (7 - n);
  }
  return bits;
}
void main() {
  int tid = int(gl_LocalInvocationID.x);
  int x0 = int(gl_WorkGroupID.x) * COLUMNS;
  int y0 = int(gl_WorkGroupID.y) * GROUP_ROWS;
  for (int i = tid; i < WINDOW_ROWS * WINDOW_COLUMNS; i += 128) {
    int r = i / WINDOW_COLUMNS, c = i % WINDOW_COLUMNS;
    rows[r * STRIDE + c] = load_pair(x0 - 4 + c, y0 - 3 + r);
  }
  barrier();
  int row = tid / (COLUMNS / QUAD);
  int first = (tid % (COLUMNS / QUAD)) * QUAD;
  int y = y0 + row;
  if (y >= HEIGHT) return;

  uint a[QUAD];
  for (int p = 0; p < QUAD; ++p) {
    uint c = rows[(row + 3) * STRIDE + first + p + 4] - LANE_OFFSET;
    a[p] = (max(c & 0xffffu, 1u) - 1u) | ((max(c >> 16, 1u) - 1u) << 16);
  }
  uint chunk[QUAD][3];
  for (int p = 0; p < QUAD; ++p) chunk[p][0] = chunk[p][1] = chunk[p][2] = 0u;
  // Rows -3 and -2 fill chunk 2, -1 and 1 chunk 1, 2 and 3 chunk 0: the
  // upper row of each pair in bits 7..0, the lower in bits -1..-8.
  for (int k = 0; k < 6; ++k) {
    int dy = k < 3 ? k - 3 : k - 2;
    uint words[QUAD + 8];
    for (int w = 0; w < QUAD + 8; ++w) words[w] = rows[(row + 3 + dy) * STRIDE + first + w];
    for (int p = 0; p < QUAD; ++p) {
      uint bits = row_bits(words, p, a[p]);
      int target = 2 - k / 2;
      chunk[p][target] |= (k % 2 == 0) ? bits : (bits >> 8);
    }
  }
  for (int p = 0; p < QUAD; ++p) {
    int x = x0 + first + p;
    if (x >= WIDTH) break;
    uint chunk0 = ~chunk[p][0], chunk1 = ~chunk[p][1], chunk2 = ~chunk[p][2];
    int index = ((y / FEATURE_TILE) * WIDTH + x) * FEATURE_TILE + y % FEATURE_TILE;
    features[index] = uvec4((chunk0 & 0xffffu) | (chunk1 << 16), chunk2 & 0xffffu,
                            (chunk0 >> 16) | (chunk1 & 0xffff0000u), chunk2 >> 16);
  }
}
